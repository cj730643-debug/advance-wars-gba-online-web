diff --git a/src/gba/sio/netplay/session-v2.c b/src/gba/sio/netplay/session-v2.c
index eb9991be8..d9c77484d 100644
--- a/src/gba/sio/netplay/session-v2.c
+++ b/src/gba/sio/netplay/session-v2.c
@@ -187,7 +187,15 @@ static bool _absoluteDeadline(
 	struct GBALinkV2Session* session, uint64_t now,
 	uint64_t* deadline, enum GBALinkV2Reason reason,
 	const char* diagnostic) {
-	const uint64_t duration = UINT64_C(3000000);
+	/* Advance Wars Online modification: honor the existing validated network
+	 * deadline policy. Defaults remain 3s; WAN frontends may select 10s.
+	 * These are wall-clock handshake deadlines, not emulated GBA timing. */
+	enum GBALinkV2DeadlineOperation operation =
+	    reason == GBA_LINK_V2_REASON_ACCEPT_CLOCK_FAILURE
+	        ? GBA_LINK_V2_DEADLINE_ACCEPT
+	        : GBA_LINK_V2_DEADLINE_CALIBRATION;
+	const uint64_t duration =
+	    (uint64_t) session->config.deadlines.milliseconds[operation] * 1000;
 	if (now > UINT64_MAX - duration) {
 		GBALinkV2SessionFail(session, reason, diagnostic);
 		return false;
diff --git a/src/platform/libretro/gba-wifi-link.c b/src/platform/libretro/gba-wifi-link.c
index af96ea034..0af9772b8 100644
--- a/src/platform/libretro/gba-wifi-link.c
+++ b/src/platform/libretro/gba-wifi-link.c
@@ -1439,6 +1439,15 @@ static bool _buildConfig(
 	adapter->sessionConfig.estimatedJitterMs = 5;
 	adapter->sessionConfig.experimentalRuntime = true;
 	GBALinkV2DeadlinePolicyInit(&adapter->sessionConfig.deadlines);
+	/* Advance Wars Online modification: optional bounded WAN calibration.
+	 * Unset/LAN keeps the qualified upstream 3s behavior. */
+	struct retro_variable network = { .key = "mgba_link_netplay_network" };
+	if (adapter->environment &&
+	    adapter->environment(RETRO_ENVIRONMENT_GET_VARIABLE, &network) &&
+	    network.value && !strcmp(network.value, "internet")) {
+		adapter->sessionConfig.deadlines.milliseconds[
+		    GBA_LINK_V2_DEADLINE_CALIBRATION] = 10000;
+	}
 	adapter->sessionConfig.callbacks = &_sessionCallbacks;
 	adapter->sessionConfig.callbackContext = adapter;
 	return true;
