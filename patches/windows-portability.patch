diff --git a/src/util/test/hash.c b/src/util/test/hash.c
index 308ab473a..3905b31d7 100644
--- a/src/util/test/hash.c
+++ b/src/util/test/hash.c
@@ -27,10 +27,13 @@ M_TEST_DEFINE(helloWorldCrc32) {
 
 #ifndef HAVE_CRC32
 M_TEST_DEFINE(stagedCrc32) {
-	uint8_t buffer[1] = { '\n\n' };
+	/* Advance Wars Online modification: two actual bytes for the two-byte
+	 * CRC assertion; the upstream multi-character literal read out of bounds.
+	 * CRC32("\n\n") = 0x5BE3136B, independently checked with Python zlib. */
+	uint8_t buffer[2] = { '\n', '\n' };
 	assert_int_equal(crc32(0, buffer, 1), 0x32D70693);
-	assert_int_equal(crc32(0, buffer, 2), 0x09304EBD);
-	assert_int_equal(crc32(0x32D70693, buffer, 1), 0x09304EBD);
+	assert_int_equal(crc32(0, buffer, 2), 0x5BE3136B);
+	assert_int_equal(crc32(0x32D70693, buffer, 1), 0x5BE3136B);
 }
 #endif
 
